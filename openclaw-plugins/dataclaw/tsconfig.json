{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    // Typecheck only: esbuild produces dist/index.js (see the build script).
    "noEmit": true
  },
  "include": ["index.ts", "src/**/*.ts"]
}
