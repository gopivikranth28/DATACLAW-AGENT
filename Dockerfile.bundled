# Bundled image: DataClaw + OpenClaw in a single container.
# OpenClaw is installed from npm (no local clone required).
#
# Build:  docker compose -f docker-compose.bundled.yml build
# Run:    docker compose -f docker-compose.bundled.yml up

# Stage 1: Build the UI
FROM node:24.22.1-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS ui-build
WORKDIR /build
COPY ui/package.json ui/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY ui/ .
RUN npm run build

# Stage 2: Grab Node.js 24 binaries (OpenClaw 2026.10 requires >=24.22.1 <25 or >=26.12.1)
FROM node:24.22.1-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205 AS node-bin

# Stage 3: Runtime — Python 3.12 + Node 24 + OpenClaw + DataClaw
FROM python:3.12-slim-bookworm@sha256:6a0e06f5ba0b373d051aabd3fffb9b873f27f9a2a3a14bcbe37dee6f0e3bbc70

# Install uv for fast Python dependency management
COPY --from=ghcr.io/astral-sh/uv:0.12.13@sha256:b485bd65cc2cf1c9a93b3554012c9c3778cf7b1b5fd3d3096ce9e1226c97e1e6 /uv /usr/local/bin/uv

# Copy Node.js 24 from the node-bin stage (OpenClaw needs Node 24).
# npm requires lib/node_modules alongside the binary.
COPY --from=node-bin /usr/local/bin/ /usr/local/bin/
COPY --from=node-bin /usr/local/lib/node_modules/ /usr/local/lib/node_modules/

# System dependencies
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       curl ca-certificates procps openssl git lsof \
    && rm -rf /var/lib/apt/lists/*

# Install OpenClaw globally from npm. The Codex CLI is also installed
# globally — `dataclaw/auth/codex_login.py` shells out to it for
# browser-based / device-code OAuth flows when the user picks the
# "OpenAI Codex" agent backend (the Python SDK alone isn't enough).
ARG OPENCLAW_VERSION=2026.10.7
ARG CODEX_CLI_VERSION=0.164.0
RUN npm install -g openclaw@${OPENCLAW_VERSION} @openai/codex@${CODEX_CLI_VERSION} \
    # Symlink ws into global node_modules so the OpenClaw CLI can resolve it
    # when invoked from any working directory (e.g. docker exec).
    && ln -sf /usr/local/lib/node_modules/openclaw/node_modules/ws /usr/local/lib/node_modules/ws

WORKDIR /dataclaw

# Copy plugins first — pyproject.toml references them as local path deps
COPY plugins/ plugins/
# dataclaw-hermes force-includes ../../hermes-plugins/dataclaw into its build
COPY hermes-plugins/ hermes-plugins/

# Install Python dependencies (layer cache)
COPY pyproject.toml uv.lock* ./
RUN mkdir -p dataclaw && touch dataclaw/__init__.py \
    && uv sync --frozen --no-dev

# Copy backend source (overwrites the stub __init__.py)
COPY dataclaw/ dataclaw/

# Copy built UI from stage 1
COPY --from=ui-build /build/dist ui/dist/

# Copy OpenClaw plugins source
COPY openclaw-plugins/ openclaw-plugins/

# Build the dataclaw plugin: openclaw 2026.5+ requires the runtime entry to
# exist on disk as JS at ./dist/index.js. The build script (esbuild from
# devDependencies) bundles ./index.ts → ./dist/index.js with openclaw/* left
# external. devDeps are required for the build, so don't pass --omit=dev here.
RUN cd openclaw-plugins/dataclaw \
    && npm ci --no-audit --no-fund \
    && npm run build

# Copy entrypoint + install helper. install_dataclaw_plugin.py invokes the
# canonical install_plugin_atomic flow (same code path the UI's Install
# button runs) so the bundled bootstrap stays in lockstep with the UI.
COPY scripts/entrypoint-bundled.sh /entrypoint.sh
COPY scripts/install_dataclaw_plugin.py /dataclaw/scripts/install_dataclaw_plugin.py
RUN chmod +x /entrypoint.sh /dataclaw/scripts/install_dataclaw_plugin.py

# Environment
ENV DISPLAY=:0
ENV TERM=xterm-256color
ENV OPENCLAW_DISABLE_BONJOUR=1
ENV NODE_ENV=production

EXPOSE 8000 18789 18790

CMD ["/entrypoint.sh"]
